VITE_API_BASE=/v2/lens/migration/api/v1
# Point auth URL to the gateway (so frontend hits /oauth2/authorization on the gateway)
# The gateway will proxy/redirect to Keycloak as appropriate.
VITE_AUTH_URL=http://localhost:8050
# Use the registration id that the gateway registers for the Keycloak provider
# (the gateway configuration uses 'keycloak' as the registration id)
VITE_AUTH_CLIENT=keycloak
# Actual Keycloak client ID (registered in Keycloak realm)
VITE_KEYCLOAK_CLIENT_ID=lens-client

